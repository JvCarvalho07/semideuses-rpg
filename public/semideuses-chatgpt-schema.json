{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jvcarvalho07.github.io/semideuses-rpg/semideuses-chatgpt-schema.json",
  "title": "Semideuses RPG V4",
  "type": "object",
  "required": ["version", "name", "filiation", "abilityGroups", "equipment", "personality"],
  "properties": {
    "version": { "enum": [3, 4] }, "avatarDataUrl": { "type": "string" }, "name": { "type": "string" },
    "legendDestiny": { "type": "string" }, "filiation": { "type": "string" }, "pathName": { "type": "string" }, "origin": { "type": "string" },
    "level": { "type": "integer", "minimum": 1 }, "hp": { "type": "number" }, "hpMax": { "type": "number", "description": "Opcional. Só vale se diferir do cálculo do livro; prefira hpMaxOverride." }, "hpMaxOverride": { "type": ["number", "null"], "description": "null = PV máximo calculado pelo livro (DV da filiação + CON)." }, "hpTemp": { "type": "number" },
    "mana": { "type": "number" }, "manaMax": { "type": "number", "description": "Opcional. Só vale se diferir do cálculo do livro; prefira manaMaxOverride." }, "manaMaxOverride": { "type": ["number", "null"], "description": "null = MP máximo calculado pelo livro (6 + Conjuração, depois 2 + Conjuração por nível)." }, "divineResource": { "type": "number", "description": "Valor atual do recurso da Assinatura (pode ser negativo na Maré de Poseidon, de -3 a +3)." }, "resourceMaxOverride": { "type": ["number", "null"], "description": "null = teto do recurso calculado pelo livro." }, "skillRankOverrides": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 }, "description": "Só as perícias que diferem do livro (filiação + antecedente). 0 = sem treino, 1 = proficiente, 2 = especialista." }, "favor": { "type": "integer", "minimum": 0, "maximum": 5 },
    "castingAttribute": { "enum": ["for", "des", "con", "int", "sab", "car"] }, "castingDcOverride": { "type": ["number", "null"] },
    "attributes": { "type": "object", "additionalProperties": { "type": "number" } }, "saveProficiencies": { "type": "array", "items": { "type": "string" } },
    "speed": { "type": "number" }, "initiativeExtra": { "type": "number", "description": "Bônus além do +2 de Reflexos de TDAH, que já é automático na versão 4." }, "caExtra": { "type": "number" },
    "caOverride": { "type": ["number", "null"] }, "initiativeOverride": { "type": ["number", "null"] },
    "speedOverride": { "type": ["number", "null"] }, "perceptionOverride": { "type": ["number", "null"] },
    "dracmas": { "type": "number", "minimum": 0 }, "humanMoney": { "type": "number", "minimum": 0 }, "humanMoneyCurrency": { "type": "string", "minLength": 1 },
    "abilityGroups": { "type": "object", "required": ["abilities", "filiation", "path", "skills", "talents"], "additionalProperties": { "type": "array", "items": { "type": "object", "additionalProperties": true } } },
    "filiationSignatures": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/filiationSignature" } } },
    "equipment": { "type": "array", "items": { "type": "object", "properties": { "armorCategory": { "enum": ["", "Leve", "Média", "Pesada"], "description": "Armadura: Leve soma DES, Média soma DES (máx. +2), Pesada é fixa. Vazio = armorClass é a CA final." } }, "additionalProperties": true } },
    "effects": { "type": "array", "description": "Bênçãos e maldições. Só as com active=true entram nos números.", "items": { "type": "object", "properties": { "kind": { "enum": ["Bênção", "Maldição"] }, "name": { "type": "string" }, "source": { "type": "string" }, "duration": { "type": "string" }, "description": { "type": "string" }, "active": { "type": "boolean" }, "ca": { "type": "integer" }, "initiative": { "type": "integer" }, "speed": { "type": "integer" }, "hpMax": { "type": "integer" } }, "additionalProperties": true } },
    "personality": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": true,
  "$defs": {
    "filiationSignature": {
      "type": "object",
      "required": ["id", "sourceId", "title", "rules", "selectedOptions", "notes", "custom"],
      "properties": {
        "id": { "type": "string" }, "sourceId": { "type": "string" }, "title": { "type": "string" }, "rules": { "type": "string" },
        "summary": { "type": "string" }, "recovery": { "type": "string" }, "costs": { "type": "string" }, "notes": { "type": "string" }, "custom": { "type": "boolean" },
        "selectedOptions": { "type": "object", "additionalProperties": { "type": "string" } },
        "resource": { "type": "object", "required": ["name", "current", "max", "unit"], "properties": { "name": { "type": "string" }, "current": { "type": "number" }, "max": { "type": "number" }, "unit": { "type": "string" } }, "additionalProperties": true },
        "moves": { "type": "array", "items": { "type": "object", "required": ["id", "name", "cost", "activation", "description"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "cost": { "type": "string" }, "activation": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": true } },
        "officialSnapshot": { "type": "object", "properties": { "sourceId": { "type": "string" }, "title": { "type": "string" }, "rules": { "type": "string" }, "pdfPage": { "type": "integer" } }, "additionalProperties": true }
      },
      "additionalProperties": true
    }
  }
}
